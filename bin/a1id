#!/usr/bin/env bash
# a1id —— a1 多身份切换器(串行;a1 不支持并发多身份)
#
# 机制:a1 凭据固定在 ~/.config/a1/auth.yaml,只能持一个身份,且写入用临时文件
# rename(会替换符号链接)。故各身份的 auth.yaml 各存一份真文件,切换=复制覆盖
# live,登录=登完把 live 复制回该身份 store。串行切换(a1 本就不支持并发)。
#
# 三个身份:
#   jarvis  —— 默认身份(open_jarvis),Jarvis 全程用它。
#   chenyi  —— 陈汉璋(工号 320687,chenhanzhang.chz@alibaba-inc.com)。非默认身份,
#              Jarvis 不得擅用,仅当面授权时临时 `as chenyi`,用完即回 jarvis
#              (无代码硬门,纪律见 CLAUDE.md 第8条)。
#   guozai  —— 郭子龙(工号 484483,guozai.gzl@alibaba-inc.com)。非默认身份,
#              Jarvis 不得擅用,仅当面授权时临时 `as guozai`,用完即回 jarvis
#              (无代码硬门,纪律见 CLAUDE.md 第8条)。
#   linjun  —— 李超林(工号 429768,lichaolin.lcl@alibaba-inc.com)。非默认身份,
#              Jarvis 不得擅用,仅当面授权时临时 `as linjun`,用完即回 jarvis
#              (无代码硬门,纪律见 CLAUDE.md 第8条)。
#
# 用法:
#   a1id login  <jarvis|chenyi|guozai|linjun>    登录并保存该身份(交互 BUC SSO)
#   a1id use    <jarvis|chenyi|guozai|linjun>    把 active 持久切到某身份
#   a1id status                                  看当前 active 身份
#   a1id who                                     看 a1 实际登录账号(透传 auth whoami)
#   a1id as <jarvis|chenyi|guozai|linjun> -- ... 以指定身份跑一条 a1,跑完自动还原原身份
#   a1id -- <a1 args...>                  以默认身份(jarvis)跑
set -euo pipefail

A1="${A1_BIN:-a1}"
CFG="${A1_CONFIG_DIR:-$HOME/.config/a1}"
STORE="$CFG/identities"
LIVE="$CFG/auth.yaml"
ACTIVE="$STORE/.active"        # 记当前 active 身份名
DEFAULT_ID="jarvis"

mkdir -p "$STORE"
die(){ echo "a1id: $*" >&2; exit 1; }
store_for(){ echo "$STORE/$1.auth.yaml"; }
valid(){ [ "$1" = jarvis ] || [ "$1" = chenyi ] || [ "$1" = guozai ] || [ "$1" = linjun ]; }
# label → 期望 BUC 账号(护栏基线;login 后 whoami 必须回来匹配,否则不落盘)
expected_account_for(){
  case "$1" in
    jarvis) echo "open_jarvis" ;;
    chenyi) echo "chenhanzhang.chz" ;;
    guozai) echo "guozai.gzl" ;;
    linjun) echo "lichaolin.lcl" ;;
    *) return 1 ;;
  esac
}

# 首跑迁移:仅当 live account 确为 jarvis 期望账号(open_jarvis)才收编。
# 与 login 分支 P0 护栏同源思想:防止 live 中残留的个人身份被静默灌进 jarvis 槽位。
if [ -f "$LIVE" ] && [ ! -f "$(store_for jarvis)" ]; then
  _live_acct=$(awk '/^ *account:/ {print $2; exit}' "$LIVE" 2>/dev/null || echo "")
  if [ "$_live_acct" = "$(expected_account_for jarvis)" ]; then
    cp "$LIVE" "$(store_for jarvis)" && echo jarvis > "$ACTIVE"
  else
    echo "a1id: 跳过首跑迁移(live account='${_live_acct:-<空>}' != jarvis 期望 '$(expected_account_for jarvis)'),需显式 'bin/a1id login jarvis'" >&2
  fi
  unset _live_acct
fi

cur(){ cat "$ACTIVE" 2>/dev/null || echo "$DEFAULT_ID"; }

# 切 live=该身份 store(若 active 未变则免拷),记 active
activate(){
  valid "$1" || die "未知身份 '$1'(jarvis|chenyi|guozai|linjun)"
  [ -f "$(store_for "$1")" ] || die "身份 '$1' 未登录,先 'a1id login $1'"
  cp "$(store_for "$1")" "$LIVE"; echo "$1" > "$ACTIVE"
}

cmd="${1:-status}"; shift || true
case "$cmd" in
  login)
    id="${1:-}"; valid "$id" || die "用法: a1id login <jarvis|chenyi|guozai|linjun>"
    expected="$(expected_account_for "$id")" || die "内部错误:label '$id' 无期望账号映射"
    # 备份 live,失败/不匹配时回滚,保证"login 未成功 → live 不受影响"
    live_bak=""
    if [ -f "$LIVE" ]; then live_bak="$(mktemp)"; cp "$LIVE" "$live_bak"; fi
    trap '{ if [ -n "${live_bak:-}" ] && [ -f "$live_bak" ]; then cp "$live_bak" "$LIVE" 2>/dev/null || true; rm -f "$live_bak"; fi; }' EXIT
    "$A1" auth login --buc
    got=$("$A1" auth whoami 2>/dev/null | awk '/Account:/{print $2}' || true)
    if [ "$got" != "$expected" ]; then
      die "身份不匹配:请求登入 '$id'(期望账号 $expected),实际浏览器 BUC 会话是 '${got:-<空>}'。
     修:1) 浏览器登出 BUC (https://buc.alibaba-inc.com/);
        2) 或用无痕/其它浏览器登 '$expected';
        3) 重跑 'bin/a1id login $id'。
     已回滚 live auth.yaml,原身份未受影响。"
    fi
    trap - EXIT
    [ -n "$live_bak" ] && rm -f "$live_bak"
    cp "$LIVE" "$(store_for "$id")"; echo "$id" > "$ACTIVE"   # 登完落盘到该身份 store
    echo "a1id: '$id'($got) 登录已保存"; "$A1" auth whoami ;;
  use)  id="${1:-}"; activate "$id"; echo "a1id: active=$id" ;;
  status) echo "active : $(cur)" ;;
  who) "$A1" auth whoami ;;
  as)
    id="${1:-}"; shift || true; [ "${1:-}" = "--" ] && shift
    prev="$(cur)"
    trap 'activate "$prev" >/dev/null 2>&1 || true' EXIT
    activate "$id"; "$A1" "$@" ;;
  --) activate "$DEFAULT_ID"; "$A1" "$@" ;;
  *) sed -n '2,22p' "$0"; exit 1 ;;
esac
