#!/usr/bin/env bash
# bin/a1id v2 —— a1 多身份并发切换器
#
# v1 vs v2:
#   v1 假设 a1 不支持多身份并发,把各身份 auth.yaml 各存一份文件
#      (identities/<label>.auth.yaml),切换=复制覆盖 live(~/.config/a1/auth.yaml),
#      依赖 live,串行。
#   v2 利用 a1 CLI 尊重 A1_CONFIG_DIR 环境变量的事实,给每个身份分配独立
#      config dir(identities/<label>/,内含 auth.yaml),`as`/`--` 只是把
#      A1_CONFIG_DIR 指到目标身份 dir 再 exec a1——不改 live、不改 .active、
#      无 trap 还原,天然并发安全。
#
# ⚠ 注意:v2 的根目录是 A1ID_ROOT(默认 ~/.config/a1),而 A1_CONFIG_DIR 是 a1
# CLI 自己的环境变量;v2 会按身份覆盖 A1_CONFIG_DIR 传给子进程 a1,不再从
# A1_CONFIG_DIR 读取 a1id 自己的根路径(测试可用 A1ID_ROOT 隔离)。
#
# 六个真实身份(数字员工 + Terraform 统一公共身份 + 个人):
#   jarvis        —— 默认(Aone 数字员工,BUC Account = WORKER_1782379562571),编排层用
#   terraform-rd  —— Terraform 唯一对外数字人(WORKER_1783582458263),内部仍可按 PD/RD/QA 分工
#   chenyi        —— 陈汉璋(chenhanzhang.chz);Jarvis 不得擅用,仅当面授权时切
#   guozai        —— 郭子龙(guozai.gzl);Jarvis 不得擅用,仅当面授权时切
#   linjun        —— 李超林(lichaolin.lcl);Jarvis 不得擅用,仅当面授权时切
#   shanye        —— 徐茈琦/杉也(shanye.xzq);Jarvis 不得擅用,仅当面授权时切
#
# 环境变量:
#   A1ID_ROOT              a1id 根目录(默认 ~/.config/a1);测试隔离用
#   A1_BIN                 a1 二进制路径(默认 a1);测试打桩用
#   JARVIS_A1_IDENTITY     默认身份覆盖(经 canon+valid 校验;未知值直接 die)
#                          terraform-rd 未登录一律 die(不允许对外回退 jarvis);
#                          其它非 jarvis 身份沿用非 strict 回退;个人身份会 stderr 告警
#   JARVIS_A1_STRICT       严格模式(=1):默认身份未登录时直接 die,不回退
#   JARVIS_AONE_WRITE_POLICY
#                          post-pr-read-only: post-PR 子代理仅可执行明确的 Aone
#                          读操作；认领/释放由 bridge 在模型进程外完成，重要事件由
#                          bridge 的 RD-only publisher 统一发布。
#
# 用法:
#   a1id login <id>              交互 BUC SSO 登录,落盘 identities/<id>/auth.yaml
#                                (whoami 与期望账号不匹配则清盘并 die)
#   a1id use <id>                拷贝 identities/<id>/auth.yaml 到 live
#                                (仅影响人工直接跑 a1 的 live 会话,脚本链路不需要)
#   a1id status                  显示默认身份 / live active / A1ID_ROOT / 八身份登录表
#   a1id who [id]                whoami:缺省=默认身份,指定=该身份 dir
#   a1id ready <id>              脚本探测:已登录退 0,否则退 1
#   a1id as <id> -- <a1 args>    以指定身份跑一条(严格;未登录直接 die,不回退)
#   a1id -- <a1 args>            以默认身份跑(受 JARVIS_A1_IDENTITY 影响)
#
# 兼容别名:pd/qa/terraform-pd/terraform-qa → terraform-rd(每次 stderr 告警,永不读旧 auth)
#           rd → terraform-rd
set -euo pipefail

A1="${A1_BIN:-a1}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
A1_COMMAND_GUARD="$SCRIPT_DIR/../bootstrap/a1_command_guard.py"
A1_FILE_GATE="$SCRIPT_DIR/../bootstrap/a1-file-gate.py"
# v2:根目录改由 A1ID_ROOT 控制(测试隔离用),不再复用 a1 自己的 A1_CONFIG_DIR。
A1ID_ROOT="${A1ID_ROOT:-$HOME/.config/a1}"
STORE="$A1ID_ROOT/identities"
LIVE="$A1ID_ROOT/auth.yaml"
ACTIVE="$STORE/.active"        # 遗留 use 记 live active 身份名(v2 脚本链路不读)
DEFAULT_ID="jarvis"

die(){ echo "a1id: $*" >&2; exit 1; }

if [ -x /usr/bin/python3 ]; then
  A1_GUARD_PYTHON=/usr/bin/python3
else
  A1_GUARD_PYTHON="$(command -v python3 2>/dev/null || true)"
fi

# Use the exact same command parser as the runtime guard before mkdir, auth
# migration, live whoami, or any other a1 probe.  Bulk quit therefore makes
# zero real-a1 calls even on a first-run identity store.
case "${1:-}" in
  --|as)
    [ -n "$A1_GUARD_PYTHON" ] || die "a1 safety guard 需要 python3；已 fail-closed"
    [ -f "$A1_COMMAND_GUARD" ] || die "a1 safety guard 缺失:$A1_COMMAND_GUARD"
    if "$A1_GUARD_PYTHON" -I "$A1_COMMAND_GUARD" \
        --check-a1id-argv "$@"; then
      :
    else
      rc=$?
      exit "$rc"
    fi
    ;;
esac

# Hold a kernel-backed shared gate for the complete a1id → guard → a1 exec
# lifetime.  The descriptor survives every exec and the kernel releases it for
# normal exit, TERM, or KILL.  The cleaner takes the matching exclusive gate,
# eliminating the final stat→unlink owner-replacement race.
if [ "${JARVIS_A1_GATE_MODE:-}" != "shared" ] \
    || [ "${JARVIS_A1_GATE_ROOT:-}" != "$A1ID_ROOT" ]; then
  [ -n "$A1_GUARD_PYTHON" ] || die "a1 file gate 需要 python3；已 fail-closed"
  [ -f "$A1_FILE_GATE" ] || die "a1 file gate 缺失:$A1_FILE_GATE"
  exec "$A1_GUARD_PYTHON" -I "$A1_FILE_GATE" \
    --root "$A1ID_ROOT" shared -- "$0" "$@"
fi
mkdir -p "$STORE"

source "$SCRIPT_DIR/../bootstrap/post-pr-context.sh"

guard_aone_write(){
  jarvis_post_pr_context_active || return 0

  # Reuse the Python classifier that understands Cobra inherited global flags
  # before/between command words.  The runtime gate is authoritative even when
  # a model hides a1id behind Python subprocess and bypasses shell-level static
  # inspection.
  [ -n "$A1_GUARD_PYTHON" ] || die "Aone write guard 需要 python3；已 fail-closed"
  [ -f "$A1_COMMAND_GUARD" ] || die "Aone write guard 缺失:$A1_COMMAND_GUARD"
  if "$A1_GUARD_PYTHON" -I "$A1_COMMAND_GUARD" \
      --check-aone-write-argv -- "$@"; then
    rc=0
  else
    rc=$?
  fi
  [ "$rc" -eq 0 ] && return 0
  if [ "$rc" -eq 2 ]; then
    die "post-PR 子代理对 Aone 只读；仅允许明确查询，认领/释放及其它写操作由 bridge 在模型进程外执行"
  fi
  die "Aone write guard 判定失败(rc=$rc)；已 fail-closed"
}

# Terraform 身份收口：旧 PD/QA label 只作为兼容别名解析到唯一公共 terraform-rd。
# 告警必须在 canon 时发出，覆盖 login/use/who/ready/as/JARVIS_A1_IDENTITY 全入口。
canon(){
  case "$1" in
    pd|qa|terraform-pd|terraform-qa)
      echo "a1id: 警告 — '$1' 是旧 Terraform 身份兼容别名，已统一改用 terraform-rd；不会读取旧 '$1' auth" >&2
      echo "terraform-rd"
      ;;
    rd) echo "terraform-rd" ;;
    *)  echo "$1" ;;
  esac
}

# 六身份注册表(增删同步 expected_account_for、迁移循环、status 表)。
valid(){
  case "$1" in
    jarvis|terraform-rd|chenyi|guozai|linjun|shanye) return 0 ;;
    *) return 1 ;;
  esac
}

# 个人身份集合(供纪律告警;非编排层默认可用)。
is_personal(){
  case "$1" in
    chenyi|guozai|linjun|shanye) return 0 ;;
    *) return 1 ;;
  esac
}

# label → 期望 BUC 账号集合(空格分隔;护栏基线:login 后 whoami 的 Account 命中集合之一才落盘)。
# 数字人 worker 两代开号 whoami 呈现不同:老式(jarvis)Account=WORKER_<empId>;新式(terraform-rd)
# Account=账号名(实测为 'terraform-rd'),故收录 empId 与账号名两种。
expected_account_for(){
  case "$1" in
    jarvis)       echo "WORKER_1782379562571" ;;
    terraform-rd) echo "WORKER_1783582458263 terraform-rd" ;;
    chenyi) echo "chenhanzhang.chz" ;;
    guozai) echo "guozai.gzl" ;;
    linjun) echo "lichaolin.lcl" ;;
    shanye) echo "shanye.xzq" ;;
    *) return 1 ;;
  esac
}

# got 是否命中 label 可接受账号集合之一(空值一律不命中)
account_matches(){
  _am_label="$1"; _am_got="$2"
  [ -n "$_am_got" ] || return 1
  for _am_acct in $(expected_account_for "$_am_label"); do
    if [ "$_am_got" = "$_am_acct" ]; then unset _am_label _am_got _am_acct; return 0; fi
  done
  unset _am_label _am_got _am_acct
  return 1
}

id_dir(){ echo "$STORE/$1"; }
id_auth(){ echo "$STORE/$1/auth.yaml"; }
is_logged_in(){ [ -s "$(id_auth "$1")" ]; }

# Every normal a1 execution crosses the repository safety gate.  The gate
# permanently rejects app pipeline exit-cr, app pipeline quit, and app cr quit.
guarded_exec(){
  local id="$1"; shift
  [ -f "$A1_COMMAND_GUARD" ] || die "a1 safety guard 缺失:$A1_COMMAND_GUARD"
  [ -n "$A1_GUARD_PYTHON" ] || die "a1 safety guard 需要 python3；已 fail-closed"
  A1_CONFIG_DIR="$(id_dir "$id")" exec "$A1_GUARD_PYTHON" -I \
    "$A1_COMMAND_GUARD" --a1-bin "$A1" -- "$@"
}

# ---- v1 → v2 自动迁移(幂等、非破坏)-------------------------------------
# 对每个注册 label,若 v1 文件 identities/<label>.auth.yaml 存在且 v2
# identities/<label>/auth.yaml 不存在 → mkdir + cp(v1 保留不删,便于回退)。
for _label in jarvis terraform-rd chenyi guozai linjun shanye; do
  _v1="$STORE/$_label.auth.yaml"
  _v2="$(id_auth "$_label")"
  if [ -f "$_v1" ] && [ ! -f "$_v2" ]; then
    mkdir -p "$(id_dir "$_label")"
    cp "$_v1" "$_v2"
    echo "a1id: v1→v2 迁移 '$_label':$_v1 → $_v2(v1 保留)" >&2
  fi
done
unset _label _v1 _v2

# ---- 首跑 live 收编(仅 jarvis v2 dir + v1 文件都不存在时)---------------
# 保留 v1 语义:以 a1 auth whoami 的 Account 字段(BUC)为门,匹配 jarvis 期望
# 账号才收编到 v2 布局。与 login 分支同源,避免 yaml account 字段(open_jarvis)
# 与 BUC Account(WORKER_...)不对称误拦。
if [ -f "$LIVE" ] && [ ! -f "$(id_auth jarvis)" ] && [ ! -f "$STORE/jarvis.auth.yaml" ]; then
  # whoami 必须锚定 A1ID_ROOT(=$LIVE 所在),否则环境残留的 A1_CONFIG_DIR 会让门校验与
  # 待收编文件不同源,可能误把别人凭据判成 jarvis。
  _live_acct=$(A1_CONFIG_DIR="$A1ID_ROOT" "$A1" auth whoami 2>/dev/null | awk '/Account:/{print $2}' || true)
  if account_matches jarvis "$_live_acct"; then
    mkdir -p "$(id_dir jarvis)"
    cp "$LIVE" "$(id_auth jarvis)"
    echo jarvis > "$ACTIVE"
    echo "a1id: v2 首跑收编 live jarvis 到 $(id_auth jarvis)" >&2
  else
    echo "a1id: 跳过首跑迁移(live whoami Account='${_live_acct:-<空>}' != jarvis 期望 '$(expected_account_for jarvis)'),需显式 'bin/a1id login jarvis'" >&2
  fi
  unset _live_acct
fi

# ---- 默认身份解析(canon+valid+登录状态+个人身份告警)-------------------
# echo 结果给调用方;die 走 stderr 并非零退出。
resolve_default(){
  local raw="${JARVIS_A1_IDENTITY:-$DEFAULT_ID}"
  local id
  id="$(canon "$raw")"
  if ! valid "$id"; then
    die "未知 JARVIS_A1_IDENTITY '$raw'(合法:jarvis|terraform-rd|chenyi|guozai|linjun|shanye,旧 pd/qa/terraform-pd/terraform-qa 仅兼容映射到 terraform-rd)"
  fi
  # 个人身份纪律告警(仅在 env 显式设置时提;不阻断,对齐 CLAUDE.md 身份纪律)
  if [ -n "${JARVIS_A1_IDENTITY:-}" ] && is_personal "$id"; then
    echo "a1id: 警告 — 使用个人身份 '$id'(via JARVIS_A1_IDENTITY),仅仓库主人本轮当面授权时才允许(CLAUDE.md 身份纪律)" >&2
  fi
  # terraform-rd 是 Terraform 唯一公共写身份，未登录必须阻断；回退 jarvis 会破坏单写者契约。
  # 其它身份仍沿用 strict → die / 非 strict 可回退 jarvis 的历史语义。
  if ! is_logged_in "$id"; then
    if [ "$id" = "terraform-rd" ]; then
      die "身份 'terraform-rd' 未登录；Terraform 对外写禁止回退 jarvis，先 'bin/a1id login terraform-rd'"
    elif [ "${JARVIS_A1_STRICT:-0}" = "1" ]; then
      die "身份 '$id' 未登录(JARVIS_A1_STRICT=1),先 'bin/a1id login $id'"
    fi
    if [ "$id" != "jarvis" ] && is_logged_in jarvis; then
      echo "a1id: 警告 — 身份 '$id' 未登录,回退到默认 jarvis(先 'bin/a1id login $id' 才能真正以该身份跑)" >&2
      id="jarvis"
    else
      die "身份 '$id' 未登录,先 'bin/a1id login $id'"
    fi
  fi
  echo "$id"
}

# 遗留 use:copy 该身份 auth.yaml 到 live,记 active(供人工直接跑 a1 的 live 会话)。
legacy_use(){
  local id="$1"
  valid "$id" || die "未知身份 '$id'"
  local a; a="$(id_auth "$id")"
  # 与 is_logged_in 同判据:空文件不该算已登录(O3 一致性)。
  [ -s "$a" ] || die "身份 '$id' 未登录,先 'bin/a1id login $id'"
  cp "$a" "$LIVE"
  echo "$id" > "$ACTIVE"
}

cmd="${1:-status}"; shift || true
case "$cmd" in
  login)
    id_raw="${1:-}"; [ -n "$id_raw" ] || die "用法: a1id login <jarvis|terraform-rd|chenyi|guozai|linjun|shanye>(旧 pd/qa label 兼容映射到 terraform-rd)"
    id="$(canon "$id_raw")"
    valid "$id" || die "用法: a1id login <jarvis|terraform-rd|chenyi|guozai|linjun|shanye>(旧 pd/qa label 兼容映射到 terraform-rd)"
    expected="$(expected_account_for "$id")" || die "内部错误:label '$id' 无期望账号映射"
    dir="$(id_dir "$id")"
    mkdir -p "$dir"
    auth="$(id_auth "$id")"

    # 备份该身份 dir 内已有 auth.yaml(如有),供 a1 login 失败 / whoami 不匹配路径 trap 回滚。
    # v1 trap 语义搬到身份 dir 版本:保护重登前的合法凭据,live 全程不动。
    auth_bak=""
    if [ -f "$auth" ]; then
      auth_bak="$(mktemp)"
      cp "$auth" "$auth_bak"
    fi
    # EXIT trap:两条失败路径统一回滚(a1 login 退非零 → set -e 引起退出 → EXIT 触发;
    # whoami 不匹配 → die → exit 1 → EXIT 触发)。成功路径末尾 `trap - EXIT` 清掉。
    _rollback_login(){
      if [ -n "${auth_bak:-}" ] && [ -f "$auth_bak" ]; then
        cp "$auth_bak" "$auth" 2>/dev/null || true
        rm -f "$auth_bak"
      elif [ -f "$auth" ]; then
        rm -f "$auth"
      fi
    }
    # 描述 trap 将做什么(die 消息里用,提示与实际行为一致)
    _rollback_note(){
      if [ -n "${auth_bak:-}" ]; then
        echo "原有凭据将由 EXIT trap 还原"
      else
        echo "本次污染的 auth.yaml 将由 EXIT trap 清理"
      fi
    }
    trap '_rollback_login' EXIT

    # v2 交互登录:A1_CONFIG_DIR 指到该身份 dir 让 a1 直接写入。
    # a1 login 自身失败(退非零)会由 set -e 直接触发 EXIT trap 回滚;这里显式检测同时补一条明确 stderr。
    if ! A1_CONFIG_DIR="$dir" "$A1" auth login --buc; then
      die "a1 auth login 失败(退非零);$(_rollback_note),live 全程未动。"
    fi
    got=$(A1_CONFIG_DIR="$dir" "$A1" auth whoami 2>/dev/null | awk '/Account:/{print $2}' || true)
    if ! account_matches "$id" "$got"; then
      die "身份不匹配:请求登入 '$id'(可接受账号: $expected),实际浏览器 BUC 会话是 '${got:-<空>}'。
     修:1) 浏览器登出 BUC (https://buc.alibaba-inc.com/);
        2) 或用无痕/其它浏览器登 '$expected';
        3) 重跑 'bin/a1id login $id'。
     $(_rollback_note),live 全程未动。"
    fi

    # 成功:清 trap + 删备份;live 全程未动。
    trap - EXIT
    [ -n "$auth_bak" ] && rm -f "$auth_bak"
    unset auth_bak
    echo "a1id: '$id'($got) 登录已保存($dir)"
    A1_CONFIG_DIR="$dir" "$A1" auth whoami
    ;;
  use)
    id_raw="${1:-}"; [ -n "$id_raw" ] || die "用法: a1id use <id>"
    id="$(canon "$id_raw")"
    legacy_use "$id"
    echo "a1id: live active=$id(仅影响人工直接跑 a1 的 live 会话,脚本链路走 A1_CONFIG_DIR 不受影响)"
    ;;
  status)
    # 不 strict + 抑 stderr,让 status 在任何登录态都能显示表格。
    # 内层子 shell 是为了让 resolve_default 里的 die/exit 只终止内层,外层的 || echo 才能兜底。
    default_id=$( (JARVIS_A1_STRICT=0 resolve_default) 2>/dev/null || echo "$DEFAULT_ID")
    printf 'default identity : %s' "$default_id"
    if [ -n "${JARVIS_A1_IDENTITY:-}" ]; then
      printf ' (JARVIS_A1_IDENTITY=%s)' "$JARVIS_A1_IDENTITY"
    fi
    printf '\n'
    printf 'live active      : %s\n' "$(cat "$ACTIVE" 2>/dev/null || echo '<none>')"
    printf 'A1ID_ROOT        : %s\n' "$A1ID_ROOT"
    printf '\n身份表:\n'
    printf '  %-14s %-24s %s\n' "label" "expected account" "logged-in"
    for label in jarvis terraform-rd chenyi guozai linjun shanye; do
      acct=$(expected_account_for "$label")
      if is_logged_in "$label"; then flag="yes"; else flag="no"; fi
      printf '  %-14s %-24s %s\n' "$label" "$acct" "$flag"
    done
    ;;
  who)
    id_raw="${1:-}"
    if [ -n "$id_raw" ]; then
      id="$(canon "$id_raw")"
      valid "$id" || die "未知身份 '$id_raw'"
      is_logged_in "$id" || die "身份 '$id' 未登录,先 'bin/a1id login $id'"
    else
      id=$(resolve_default) || exit $?
    fi
    A1_CONFIG_DIR="$(id_dir "$id")" "$A1" auth whoami
    ;;
  ready)
    id_raw="${1:-}"; [ -n "$id_raw" ] || die "用法: a1id ready <id>"
    id="$(canon "$id_raw")"
    valid "$id" || exit 1
    is_logged_in "$id"
    ;;
  as)
    id_raw="${1:-}"; shift || true; [ "${1:-}" = "--" ] && shift
    [ -n "$id_raw" ] || die "用法: a1id as <id> -- <a1 args...>"
    guard_aone_write "$@"
    id="$(canon "$id_raw")"
    valid "$id" || die "未知身份 '$id_raw'(合法 jarvis|terraform-rd|chenyi|guozai|linjun|shanye,旧 pd/qa label 兼容映射到 terraform-rd)"
    is_logged_in "$id" || die "身份 '$id' 未登录,先 'bin/a1id login $id'"
    # v2:纯 env 方式跑,不动 live,不 trap,天然并发安全；执行前统一过 a1 安全门。
    guarded_exec "$id" "$@"
    ;;
  --)
    guard_aone_write "$@"
    id=$(resolve_default) || exit $?
    guarded_exec "$id" "$@"
    ;;
  *)
    sed -n '2,45p' "$0"; exit 1
    ;;
esac
