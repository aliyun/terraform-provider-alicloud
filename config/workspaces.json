{
  "workspaces": {
    "terraform_provider": {
      "repo": "terraform-provider-alicloud",
      "git_url": "git@github.com:ChenHanZhang/terraform-provider-alicloud.git",
      "upstream_remote": "alicloud", "origin_remote": "origin", "default_branch": "master",
      "pools": ["tf_provider","tf_customer"],
      "ops": {"build":"go build ./...","test":"go test ./alicloud -run <Name>","vet":"go vet ./...","fmt":"gofmt -l alicloud/"},
      "desc": "alicloud provider 开发/评审; 评审看 alicloud(=upstream aliyun) PR, 改在 origin=ChenHanZhang fork"
    },
    "automation_agent": {
      "repo": "aliyun-automation-agent",
      "git_url": "git@gitlab.alibaba-inc.com:opensource-tools/aliyun-automation-agent.git",
      "app": 283346,
      "default_branch": "master",
      "pool": "mcp_server",
      "delivery": "delivery-aliyun-automation-agent.md",
      "ops": {}
    },
    "mcp_server": {
      "repo": "cloudspec",
      "git_url": "git@gitlab.alibaba-inc.com:cloudspec-mcp/cloudspec.git",
      "app": 260634,
      "default_branch": "master",
      "ops": {"build":"./mvnw -q -DskipTests package","test":"./mvnw -q -Dtest=AlibabaCloudListApisCallTest test"},
      "desc": "Cloudspec MCP / OpenAPI MCP Server"
    },
    "automation_platform": {
      "repo": "aliyun-automation-platform",
      "git_url": "git@gitlab.alibaba-inc.com:aliyun-automation-platform/aliyun-automation-platform.git",
      "app": 172823,
      "default_branch": "master",
      "ops": {},
      "desc": "IaCService / 自动化服务台"
    },
    "agent_toolkit": {
      "repo": "alibabacloud-agent-toolkit",
      "git_url": "git@github.com:ChenHanZhang/alibabacloud-agent-toolkit.git",
      "origin_remote": "origin", "default_branch": "main",
      "pools": ["api_toolkit"],
      "loop": "loops/plugin-dev.md",
      "ops": {"validate":"python3 tools/validate.py","lint":"npx markdownlint-cli2 '**/*.md' '#node_modules'","hooks":"bash tools/dev-hooks/verify-hooks.sh"},
      "test_profile": "TerraformUT",
      "desc": "Claude Code 插件市场（core/spec-ops/iac-service）; 新插件照搬 core, 见 loops/plugin-dev.md, 实测用 TerraformUT"
    },
    "acube": {
      "repo": "a-cube-aliyun-com",
      "git_url": "git@gitlab.alibaba-inc.com:opensource-tools/a-cube-aliyun-com.git",
      "default_branch": "master",
      "app": 180726,
      "pools": ["api_toolkit"],
      "ops": {},
      "desc": "自动化能力管理内部平台; Terraform 自动化测试集成/度量/发布; 池 api_toolkit"
    },
    "terraform_generator_v4": {
      "repo": "terraform-generator-v4",
      "git_url": "git@gitlab.alibaba-inc.com:opensource-tools/terraform-generator-v4.git",
      "default_branch": "main",
      "pools": ["api_toolkit"],
      "ops": {"test":"composer test", "lint":"composer lint"},
      "desc": "Terraform generator v4; Acube Terraform 代码生成器问题定位/转单/修复"
    },
    "jarvis": {
      "repo": "jarvis",
      "git_url": "git@gitlab.alibaba-inc.com:terraflow/jarvis.git",
      "default_branch": "master",
      "pools": ["api_toolkit"],
      "ops": {"test":"bash bootstrap/tests/aone_comment_format.sh && bash bootstrap/tests/wrap_done.sh"},
      "desc": "Jarvis 自治工作台; Aone triage、流程编排、自我迭代和内部研发提效"
    }
  }
}
