#!/usr/bin/env bash
# bootstrap/git-hooks/pre-commit
# 通过 core.hooksPath=bootstrap/git-hooks 启用(在 preflight.sh 里 idempotent 设置)。
#
# 责任:兜底 .claude/skills 与 .agents/skills 双份镜像门禁。主线是 PostToolUse
# hook(.claude/settings.json + .codex/hooks.json)实时同步 + token 替换,本 hook
# 只接住主线漏掉的场景(Bash 改文件 / 外部编辑器 / 其它 agent / hook 静默失败)。
#
# 只 check **本次 staged 涉及的 mirror 路径**,避免 baseline 里既有 drift 阻断无关
# commit。普通 commit(未触到 skills / CLAUDE.md / AGENTS.md)无感通过。
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

# 过滤 mirror 相关路径
mirror_staged=$(echo "$staged" | grep -E '^\.claude/skills/|^\.agents/skills/|^CLAUDE\.md$|^AGENTS\.md$' || true)
[ -z "$mirror_staged" ] && exit 0

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$repo_root" ] || exit 0

# portable(macOS bash 3.2 无 mapfile):把换行分隔的路径读进数组
files=()
while IFS= read -r f; do
    [ -n "$f" ] && files+=("$f")
done <<< "$mirror_staged"
[ "${#files[@]}" -eq 0 ] && exit 0

# CLAUDE.md staged 时自动从 CLAUDE.md 重生成 AGENTS.md 并 git add 进本次提交:
# AGENTS.md 已入库跟踪,内容 = mirror_sed_claude_to_codex(CLAUDE.md)。CLAUDE.md 是唯一
# 真源——外部编辑器/Bash 改 CLAUDE.md 未触发 PostToolUse hook 时这里兜底重生成+入 index,
# 根治「CLAUDE 改了、AGENTS 没跟上」的手工漂移(对齐 .claude/skills→.agents 镜像做法)。
if printf '%s\n' "${files[@]}" | grep -qxF 'CLAUDE.md'; then
    bash "$repo_root/bootstrap/mirror.sh" to-codex "$repo_root/CLAUDE.md" >/dev/null 2>&1 || true
    git -C "$repo_root" add -- "$repo_root/AGENTS.md" 2>/dev/null || true
fi

exec bash "$repo_root/bootstrap/mirror.sh" check "${files[@]}"
