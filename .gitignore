# transient scratch — must NEVER hit the repo root or be committed
scratch_*
*.tmp
*.scratch

# local rebuildable state (truth lives in Aone + memory/)
.my-day/
docs/board.html

# 本机工作区路径覆盖(每台机不同，base workspaces.json 不存绝对路径)
config/workspaces.local.json
config/dingtalk-optout.txt

# runs/ 是本地审计缓存，真源在 Aone，周回顾走 bootstrap/week.sh
runs/*.md
!runs/.gitkeep

# 开发用 worktree(临时分支工作区)
.claude/worktrees/
.worktrees/
bridge/jarvis.env

# IDE 元数据
.idea/

# 本地凭据(chmod 600,双保险 gitignore;bootstrap/.env.example 是模板)
bootstrap/.env

# AGENTS.md 已入库跟踪(勿再加回 ignore):pre-commit 钩子在 CLAUDE.md 变更时自动
# 重生成同步(内容 = mirror_sed_claude_to_codex(CLAUDE.md))并 add 进本次提交,
# PostToolUse 实时 sync + preflight 兜底,入库跟踪根治手工同步漂移(取代原 P6.a untrack)

# Python bytecode
__pycache__/
.venv/

# probe 运行产物(本地审计缓存,真源在 Aone;工作目录在 .my-day/ 已忽略)
runs/probe/
# RC 门禁运行产物(发布前全资源 tier-0 + 全场景 tier-1 过一遍,本地审计缓存,真源在 Aone)
runs/rc-gate/
# terraform 本地状态兜底(严禁 state/plan 入库)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
